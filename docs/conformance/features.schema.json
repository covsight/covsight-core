{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covsight.org/schema/ucis-conformance-features-1.json",
  "title": "UCIS conformance feature registry section",
  "description": "One file per UCIS feature-catalog section. Humans commit intent (scope, reason); tools compute status. Any status-like field here is a schema violation by construction: additionalProperties is false everywhere.",
  "type": "object",
  "required": ["section", "features"],
  "additionalProperties": false,
  "properties": {
    "section": {
      "type": "object",
      "required": ["number", "title"],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "description": "Catalog section number; must match the numeric prefix of the file name."
        },
        "title": {"type": "string", "minLength": 1},
        "spec_ref": {
          "type": "string",
          "description": "UCIS 1.0 section reference, e.g. \"§ 8.5\"."
        },
        "notes": {"type": "string"}
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[0-9]{0,2}\\.[0-9]+[a-z]?$",
      "description": "Immutable feature ID, e.g. S4.4, ST.17, X.1. Never reused."
    },
    "backend_scope": {
      "type": "object",
      "required": ["scope"],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": ["core", "extended", "out_of_scope", "deferred", "unclassified"],
          "description": "The human decision. 'unclassified' is a bootstrap-only placeholder; the matrix generator exits non-zero while any remain."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Required for out_of_scope and deferred."
        },
        "adr": {
          "type": "string",
          "description": "Path to the ADR recording a deferred decision, e.g. docs/adr/0003-....md"
        },
        "issue": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"enum": ["out_of_scope", "deferred"]}}},
          "then": {"required": ["scope", "reason"]}
        }
      ]
    },
    "feature": {
      "type": "object",
      "required": ["id", "title", "kind", "backends"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "spec_ref": {"type": "string"},
        "kind": {
          "enum": ["feature", "combination", "negative"],
          "description": "combination entries must carry 'composes'."
        },
        "composes": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/id"},
          "description": "For kind: combination — the feature IDs whose interaction is under test."
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["write", "read", "merge", "query", "append", "compact"]},
          "description": "Surfaces that must handle this feature. Defaults to [write, read] when absent."
        },
        "aliases": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "description": "IDs this entry absorbed from before the registry was authoritative."
        },
        "lifecycle": {
          "enum": ["active", "superseded"],
          "default": "active",
          "description": "Withdrawal marker. A superseded entry keeps its row forever so old results stay interpretable."
        },
        "superseded_by": {"$ref": "#/$defs/id"},
        "backends": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/backend_scope"},
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
          "description": "Per-backend scope decisions. A map from day one so ncdb/c/ts become matrix columns without a schema change."
        },
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "combination"}}, "required": ["kind"]},
          "then": {"required": ["composes"]}
        },
        {
          "if": {"properties": {"lifecycle": {"const": "superseded"}}, "required": ["lifecycle"]},
          "then": {"required": ["superseded_by"]}
        }
      ]
    }
  }
}
